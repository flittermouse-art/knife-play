        <PAGEOBJECT XPOS="184" YPOS="1672" OwnPage="5" ItemID="1217583134" PTYPE="2" WIDTH="264" HEIGHT="264" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" path="M0 0 L264 0 L264 264 L0 264 L0 0 Z" copath="M0 0 L264 0 L264 264 L0 264 L0 0 Z" gXpos="184" gYpos="1344" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="184" YPOS="2000" OwnPage="6" ItemID="1217552254" PTYPE="2" WIDTH="264" HEIGHT="264" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" path="M0 0 L264 0 L264 264 L0 264 L0 0 Z" copath="M0 0 L264 0 L264 264 L0 264 L0 0 Z" gXpos="184" gYpos="1344" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="116" YPOS="32" OwnPage="0" ItemID="1215957022" PTYPE="4" WIDTH="408" HEIGHT="121.365853658537" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="Title_and_subtitle" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L408 0 L408 121.366 L0 121.366 L0 0 Z" copath="M0 0 L408 0 L408 121.366 L0 121.366 L0 0 Z" gXpos="116" gYpos="32" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1216225998" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Sapphic Sacrament Sacrilege"/>
                <para PARENT="HTML_h1"/>
                <ITEXT CH="or,"/>
                <para PARENT="Subtitle"/>
                <ITEXT CH="knife play"/>
                <para PARENT="Byline"/>
                <ITEXT CH="by Autumn Natalie Florence"/>
                <para PARENT="Byline"/>
                <breakframe/>
                <ITEXT CH="Panel 2 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="Terra smiled when she felt the cold knife’s edge touch her throat. She said “Do it, do it.”"/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 3 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="Luna pressed the knife into Terra’s skin — but only a little. Luna’s warm breath came close again. She gave a thoughtful “Hmmmm…”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Terra squirmed against the ropes a little. “Kill me.” She scrunched her face to wiggle the blindfold. “Please?”"/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 4 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="The knife’s point dragged gently, gently across her cheek."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="At last, Luna said “Why should I?”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Already Terra was pouting again. “Because — because I need it. And because you like it.”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Luna said “I do. I like seeing you all needy too.”"/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 5 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="Terra mewed. “We’ve done a bunch of slow teasing plays lately, and I don’t think I can take another one today. Please, Mistress, please, just kill me quickly.”"/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 6 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="The knife tickled the nape of Terra’s neck — then vanished. Luna laughed at her whimpers. Then silence. Then, “Alright, alright, I’ll put you out of your misery already. Poor baby.”"/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 7 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="Cold sharp plunged into Terra’s breast, hot wet poured down her belly and up her neck. Agony seized her, took her whole body and mind, tighter than her bonds, hard-stopped the whole stream of consciousness. She gasped, then tried to gasp, but couldn’t."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="The blindfold’s darkness was swallowed by a deeper darkness."/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 8 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="And then Terra "/>
                <ITEXT FONTSIZE="11" CH="glowed"/>
                <ITEXT CH=", golden joy literally shining around the knife in her heart, blooming, spreading, tickling her scalp and her toes. She cooed and sobbed and laughed, the sweat on her face, her whole face sparkling. The ropes fell slack and slithered away. The knife shrank and slipped out and tinkled on the floor. The wound in her breast closed, blood slowed to a trickle. Terra sighed her deepest satisfaction. And the blindfold lifted. Terra lay still. Then opened her eyes so she could adore Luna’s face."/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 9 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Caption:"/>
                <para PARENT="script labels"/>
                <ITEXT CH="Luna was breathing hard, thrilled, at once slaked and thirsty for more. Together they wept and giggled, and the music of their feelings resonated on the chapel walls."/>
                <para PARENT="Default Paragraph Style"/>
                <breakframe/>
                <ITEXT CH="Panel 10 of 10"/>
                <para PARENT="HTML_h3"/>
                <ITEXT CH="Credits."/>
                <trail PARENT="Default Paragraph Style"/>
            </StoryText>
        </PAGEOBJECT>
