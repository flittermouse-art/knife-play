        <PAGE PAGEXPOS="100.0008" PAGEYPOS="20.0016" PAGEWIDTH="792" PAGEHEIGHT="612" BORDERLEFT="9" BORDERRIGHT="9" BORDERTOP="9" BORDERBOTTOM="9" NUM="0" NAM="" MNAM="Normal Right" Size="Custom" Orientation="1" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="0" AGverticalAutoGap="0" AGhorizontalAutoCount="0" AGverticalAutoCount="0" AGhorizontalAutoRefer="0" AGverticalAutoRefer="0" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
        <PAGEOBJECT XPOS="304.7508" YPOS="330.5016" OwnPage="0" ItemID="1395447216" PTYPE="4" WIDTH="186.75" HEIGHT="292.5" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="page1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L186.75 0 L186.75 292.5 L0 292.5 L0 0 Z" copath="M0 0 L186.75 0 L186.75 292.5 L0 292.5 L0 0 Z" gXpos="304.7508" gYpos="330.5016" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="1395337376" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="Sapphic Sacrament Sacrilege"/>
                <para PARENT="H1 heading"/>
                <ITEXT CH="or,"/>
                <para PARENT="H1 heading"/>
                <ITEXT CH="knife play"/>
                <para PARENT="H1 heading"/>
                <ITEXT CH="by Autumn Natalie Florence"/>
                <para PARENT="byline"/>
                <ITEXT CH="@autumnflitter"/>
                <para PARENT="byline"/>
                <ITEXT CH="https://flittermouse.art"/>
                <breakframe/>
                <para PARENT="byline"/>
                <ITEXT CH="Terra smiled when she felt the cold knife’s edge touch her throat. She said “Do it, do it.”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Luna pressed the knife into Terra’s skin — but only a little. Luna’s warm breath came close again. She gave a thoughtful “Hmmmm…”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Terra squirmed against the ropes a little. “Kill me.” She scrunched her face to wiggle the blindfold. “Please?”"/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="The knife’s point dragged gently, gently across her cheek."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="At last, Luna said “Why should I?”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Already Terra was pouting again. “Because — because I need it. And because you like it.”"/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Luna said “I do. I like seeing you all needy too.”"/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Terra mewed. “We’ve done a bunch of slow teasing plays lately, and I don’t think I can take another one today. Please, Mistress, please, just kill me quickly.”"/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="The knife tickled the nape of Terra’s neck — then vanished. Luna laughed at her whimpers. Then silence. Then, “Alright, alright, I’ll put you out of your misery already. Poor baby.”"/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Cold sharp plunged into Terra’s breast, hot wet poured down her belly and up her neck. Agony seized her, took her whole body and mind, tighter than her bonds, hard-stopped the whole stream of consciousness. She gasped, then tried to gasp, but couldn’t."/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="The blindfold’s darkness was swallowed by a deeper darkness."/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="And then Terra "/>
                <ITEXT FONT="PT Serif Italic" FONTSIZE="10" CH="glowed"/>
                <ITEXT CH=", golden joy literally shining around the knife in her heart, blooming, spreading, tickling her scalp and her toes. She cooed and sobbed and laughed, the sweat on her face, her whole face sparkling. The ropes fell slack and slithered away. The knife shrank and slipped out and tinkled on the floor. The wound in her breast closed, blood slowed to a trickle. Terra sighed her deepest satisfaction. And the blindfold lifted. Terra lay still. Then opened her eyes so she could adore Luna’s face."/>
                <breakframe/>
                <para PARENT="Default Paragraph Style"/>
                <ITEXT CH="Luna was breathing hard, thrilled, at once slaked and thirsty for more. Together they wept and giggled, and the music of their feelings resonated on the chapel walls."/>
                <nbspace/>
                <ITEXT CH="∎"/>
                <trail PARENT="Default Paragraph Style"/>
            </StoryText>
        </PAGEOBJECT>
